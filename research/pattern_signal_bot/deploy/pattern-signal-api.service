[Unit]
Description=Private Pattern Signal research API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pattern-signal-bot
Environment=PYTHONPATH=/opt/pattern-signal-bot
ExecStart=/opt/futu/venv/bin/python -m pattern_signal_bot.server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
